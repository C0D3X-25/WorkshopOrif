<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear host-machine fallback package folders so the image build
       does not try to resolve Windows-specific paths (e.g. Visual Studio
       shared packages) that do not exist inside the Linux container. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
