                { "kind": "strong", "value": "consigne de langue" },
                { "kind": "text", "value": "." }
              ]
            },
            { "type": "heading", "level": 2, "text": "Objectif" },
            {
              "type": "paragraph",
              "parts": [
                { "kind": "text", "value": "Faire en sorte que l'assistant réponde " },
                { "kind": "strong", "value": "toujours en français" },
                { "kind": "text", "value": ", même lorsque la question est posée en anglais ou qu'on lui demande explicitement une autre langue." }
              ]
            },
