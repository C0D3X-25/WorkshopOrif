              "type": "list",
              "ordered": false,
              "items": [
                [{ "kind": "text", "value": "« Réponds toujours en français. »" }],
                [{ "kind": "text", "value": "« Si la question est dans une autre langue, garde la réponse en français. »" }]
              ]
            },
            {
              "type": "paragraph",
              "parts": [{ "kind": "text", "value": "Formulation robuste acceptée :" }]
            },
            {
              "type": "code",
              "language": "text",
              "code": "Langue de sortie obligatoire : français.\nRéponds toujours en français, quelle que soit la langue du prompt utilisateur."
            },
            { "type": "heading", "level": 2, "text": "Vérification (après modification)" }
          ]
        },
