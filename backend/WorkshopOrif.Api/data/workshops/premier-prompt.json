              "type": "list",
              "ordered": false,
              "items": [
                [{ "kind": "code", "value": "agent-exercice/sandbox/README.md" }],
                [{ "kind": "code", "value": "agent-exercice/sandbox/backend/requirements.txt" }],
                [{ "kind": "code", "value": "agent-exercice/sandbox/frontend/package.json" }]
              ]
            },
            { "type": "heading", "level": 2, "text": "Livrable" },
            {
              "type": "paragraph",
              "parts": [
