                { "kind": "strong", "value": "Fait | Preuve | Chemin valide ?" },
                { "kind": "text", "value": " pour au moins trois faits." }
              ]
            },
            { "type": "heading", "level": 2, "text": "Étape 4 — Test anti-hallucination" },
