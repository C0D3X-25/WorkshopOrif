                { "kind": "text", "value": "Posez " },
                { "kind": "strong", "value": "sans rien modifier" },
                { "kind": "text", "value": " :" }
              ]
            },
            {
              "type": "blockquote",
              "parts": [
                { "kind": "text", "value": "Que peux-tu me dire du projet " },
                { "kind": "code", "value": "agent-exercice/sandbox" },
                { "kind": "text", "value": " ?" }
              ]
            },
            {
              "type": "paragraph",
              "parts": [
                {
                  "kind": "text",
                  "value": "Consignez 3 exécutions dans votre tableau (langue observée : FR / EN / mixte). Une réponse partielle ou imprécise est normale à cette étape."
