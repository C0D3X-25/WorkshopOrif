    {
      "section": "Exercice",
      "title": "Niveau 0 — Imposer la langue de réponse",
      "body": "",
      "questions": [
        {
          "text": "À ce niveau, que valide-t-on principalement ?",
          "type": "single",
          "options": [
            { "text": "La contrainte de forme (langue de réponse), pas la véracité des faits", "isCorrect": true },
            { "text": "Que l'assistant cite au moins trois fichiers sources", "isCorrect": false },
            { "text": "Que la stack technique décrite soit exacte à 100 %", "isCorrect": false }
          ],
          "explanation": "Le niveau 0 porte sur la langue et la testabilité de la consigne. Une réponse en français peut encore être factuellement incorrecte."
        }
      ],
      "blocks": [
        {
          "type": "content",
          "elements": [
            { "type": "heading", "level": 2, "text": "Contexte" },
            {
              "type": "paragraph",
              "parts": [
                { "kind": "text", "value": "Vous disposez d'un assistant conversationnel ayant accès au dépôt. À ce stade, le " },
                { "kind": "strong", "value": "contenu exact" },
