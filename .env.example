# Copy this file to .env and fill in the values before running docker compose up.

# Password for the Admin UI (POST /admin/login)
ADMIN_PASSWORD=change-me

# HS256 signing secret for JWT cookies — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-32chars

# Set to "dev" to use the Vite dev server with hot-reload instead of Nginx
# FRONTEND_TARGET=dev
